# Copy to .env and fill in your keys.
# chmod 600 .env so only your user can read it.

# Elsevier Scopus Search API
SCOPUS_API_KEY=
# Optional: institutional token unlocks COMPLETE view (abstracts, affiliations, etc.)
SCOPUS_INST_TOKEN=

# Clarivate Web of Science Starter API
WOS_API_KEY=

# Email used for OpenAlex polite pool (?mailto=...). Any valid email is fine.
CONTACT_EMAIL=your.email@example.com
